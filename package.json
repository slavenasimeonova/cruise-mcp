{
  "name": "azure-horizon-cruise-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for the fictional Azure Horizon Cruises operations data",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "azure-horizon-cruise-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p web/tsconfig.json",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "web:data": "tsx web/scripts/export-data.ts",
    "web:dev": "npm run web:data && vite --config web/vite.config.ts",
    "web:build": "npm run web:data && vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
